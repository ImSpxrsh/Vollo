[internationalization]

locale/translations=PackedStringArray("res://addons/maaacks_menus_template/base/translations/menus_translations.en.translation", "res://addons/maaacks_menus_template/base/translations/menus_translations.fr.translation")

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="ball"
2d_physics/layer_3="hazard"
2d_physics/layer_4="pickups"

[maaacks_menus_template]

copy_path="res://"
disable_update_check=true
disable_install_wizard=true
disable_install_audio_busses=true
main_menu_scene_path="res://scenes/ui/MainMenu.tscn"
ending_scene_path="res://scenes/end_credits/end_credits.tscn"
loading_scene_path="res://scenes/loading_screens/loading_screen.tscn"
game_scene_path="res://scenes/game/main.tscn"

[maaacks_music_controller]

disable_install_audio_busses=true

[maaacks_scene_loader]

loading_scene_path="res://scenes/loading_screens/loading_screen.tscn"

[maaacks_ui_sound_controller]

disable_install_audio_busses=true

[physics]

2d/default_gravity=627.0
common/enable_pause_aware_picking=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0509804, 0.0588235, 0.0784314, 1)
